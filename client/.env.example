# Vite loads client/.env.<mode>: `npm run dev` uses .env.development, `npm run dev:staging` / `build:staging` use
# .env.staging, and `npm run build` uses .env.production. These values are public (they ship in the JS bundle), so
# the per-mode files are committed. Never put a secret key (sb_secret_...) in any client file.
#
# The project here must be the same one the API's SUPABASE_URL points at, or the API rejects every sign-in.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
