# Vite loads client/.env.<mode>: `pnpm run dev` uses .env.development, `pnpm run dev:staging` / `build:staging` use
# .env.staging, and `pnpm run build` uses .env.production. These values are public (they ship in the JS bundle), so
# the per-mode files are committed. Never put a secret key (sb_secret_...) in any client file.
#
# The project here must be the same one the API's SUPABASE_URL points at, or the API rejects every sign-in.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# In the web image (client/Dockerfile) the Supabase values, LOG_LEVEL and REQUEST_TIMEOUT_MS are set at start instead
# (docs/DEPLOYMENT.md "Containers"); the image is built with the placeholders in .env.container.

# Dev server port (default 5173) and where it proxies /api (default http://localhost:8000). start.sh reads
# VITE_DEV_PORT and, unless VITE_API_PROXY_TARGET is set, points the proxy at server/.env's PORT.
# VITE_DEV_PORT=5173
# VITE_API_PROXY_TARGET=http://localhost:8000

# Request timeout in ms for API calls. Unset: 15000.
# VITE_REQUEST_TIMEOUT_MS=15000

# Minimum browser console level: debug, info, warn, error or silent (see docs/LOGGING.md).
# Unset: debug in `pnpm run dev`, warn in builds. debug and info are compiled out of production builds anyway.
# VITE_LOG_LEVEL=warn
