# Rendered to /etc/nginx/conf.d/default.conf at start. ${API_UPSTREAM} and ${SUPABASE_URL} come from the environment.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        include /etc/nginx/conf.d/snippets/security.conf;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Written at start by 40-runtime-env.sh; uid 101 cannot write the html directory, so it lives in /tmp.
    location = /runtime-env.js {
        include /etc/nginx/conf.d/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
        default_type application/javascript;
        alias /tmp/runtime-env/runtime-env.js;
    }

    # Content-hashed by Vite: a changed file gets a new name.
    location /assets/ {
        include /etc/nginx/conf.d/snippets/security.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /images/ {
        include /etc/nginx/conf.d/snippets/security.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/conf.d/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
    }

    # No trailing slash on proxy_pass: with one, nginx would strip /api from the path.
    location /api/ {
        include /etc/nginx/conf.d/snippets/security.conf;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # The SPA: every other path is a client route.
    location / {
        include /etc/nginx/conf.d/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
