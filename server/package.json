{
  "name": "food-pickup-server",
  "private": true,
  "version": "0.1.0",
  "description": "Food Pickup V0 API server (Express + Supabase)",
  "main": "dist/src/server.js",
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "media:bucket": "tsx scripts/media-bucket.ts",
    "db:start": "supabase start",
    "db:start:ci": "supabase start -x studio,storage-api,imgproxy,mailpit,realtime,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local > src/types/database.ts && prettier --write src/types/database.ts",
    "db:push:staging": "./scripts/db-push.sh staging",
    "db:push:production": "./scripts/db-push.sh production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-presigned-post": "^3.1163.0",
    "@supabase/server": "^1.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supabase": "^3.1.0",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
