# Copy this file to .env (same folder). The server refuses to start without a valid .env.
#
# APP_ENV picks the Supabase project, and every value below must come from that same project:
#   local       the Docker stack from `npm run db:start` (it prints the URL and keys; the values below are its defaults)
#   staging     https://xkddnlxeeizaqpefhqlv.supabase.co
#   production  the production project. Set these on the production host; avoid keeping them in a local .env.
# start.sh reads APP_ENV and starts the web app in the matching mode, so the browser signs in to the same project.
APP_ENV=local

# Hosted: Project Settings → API Keys. The server needs the SECRET key (sb_secret_...): it reads and writes every
# table and bypasses RLS, so it must never reach the browser or git.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Only for a container reaching the local stack at http://host.docker.internal:54321 (compose.yaml sets it): the
# token signing keys' URL, which @supabase/server derives only from an https or localhost SUPABASE_URL.
# SUPABASE_JWKS_URL=

# Days a sign-in survives without use (1-90, default 7). Must equal auth.sessions.inactivity_timeout (168h) in
# supabase/config.toml; the client reads it from GET /api/config. (Hosted Supabase Free has no inactivity timeout.)
# SESSION_IDLE_DAYS=7

# Port the API server listens on. start.sh reads it for its probes and points the web app's dev proxy at it.
PORT=8000

# Seconds-scale cache for public reads (menu, store, site settings), in ms (0-600000, default 10000; 0 turns it off).
# PUBLIC_READ_TTL_MS=10000

# Proxies in front of the API whose X-Forwarded-For is trusted for req.ip (default 0; compose.yaml sets 1 for nginx).
# TRUST_PROXY_HOPS=0

# Rate limits per fixed window (docs/CONFIGURATION.md). Per address on all of /api, per signed-in user on writes,
# per address on POST /auth/register. 0 turns one off. Campus Wi-Fi shares an address, so keep the IP limit generous.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_IP_MAX=600
# RATE_LIMIT_WRITE_MAX=30
# RATE_LIMIT_REGISTER_MAX=10

# Origin of the Vite dev server, allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# The commit this build came from, reported by GET /api/health. The image build sets it; leave it unset locally.
# GIT_COMMIT=

# Idle keep-alive timeout in ms. Must exceed the load balancer's idle timeout (60 s on an ALB) or kept-alive
# connections fail with 502s. Default 65000.
# KEEP_ALIVE_TIMEOUT_MS=65000

# Minimum log level: fatal, error, warn, info, debug, trace or silent (see docs/LOGGING.md).
# Unset: debug when APP_ENV=local, info on staging and production.
# LOG_LEVEL=info

# Required only when APP_ENV=staging and the demo seed runs: the shared-staging demo accounts' passwords.
# Never the ones published in README.md (those are local only). At least 12 characters each. Only the seed script
# reads them; the API server starts without them. Not used locally or in production.
# SEED_STAFF_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=

# Tests only (docs/TESTING.md): the staging project's host, required when TEST_TARGET=staging. Never point this
# at production.
# TEST_STAGING_HOST=xkddnlxeeizaqpefhqlv.supabase.co
