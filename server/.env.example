# Copy this file to .env (same folder) and edit the first two values. The server refuses to start without a valid .env.

# PostgreSQL connection. Homebrew Postgres on macOS usually accepts your Mac username with no password
# (run `whoami` to get it). If your Postgres needs a password: postgresql://user:password@localhost:5432/food_pickup
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/food_pickup"

# Signs login tokens. At least 16 characters, and the server rejects this exact placeholder on startup.
# Generate one with:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API server listens on. Keep it at 8000: the web app's dev proxy (client/vite.config.ts) and
# start.sh both hardcode http://localhost:8000, so change all three together or not at all.
PORT=8000

# Origin of the Vite dev server, allowed by CORS.
CLIENT_ORIGIN="http://localhost:5173"
