// Food Pickup V0 — intentionally small schema (5 tables).
// Prices are whole rupees stored as integers. What the customer sees is what they pay.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Store {
  id                 String     @id @default(cuid())
  name               String
  tagline            String // e.g. "Coffee • Snacks • Quick Bites"
  description        String // e.g. "Quick bites, coffee and snacks."
  imageUrl           String?
  isOpen             Boolean    @default(true)
  prepTimeMinMinutes Int        @default(10)
  prepTimeMaxMinutes Int        @default(15) // used for estimatedReadyAt
  menuItems          MenuItem[]
  orders             Order[]
}

model MenuItem {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  category      String // "Coffee", "Snacks", "Juices", "Desserts"
  name          String
  description   String
  price         Int // whole rupees
  imageUrl      String
  isAvailable   Boolean     @default(true)
  isPopular     Boolean     @default(false)
  sortOrder     Int         @default(0)
  stockQuantity Int? // units left; null = not tracked (unlimited). Decremented per order, restored on CANCELLED.
  orderItems    OrderItem[]

  @@index([storeId, category])
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      Int           @unique @default(autoincrement()) // human-readable, e.g. #1042
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id])
  customerName     String
  customerPhone    String?
  note             String?
  total            Int // whole rupees, computed on the server only
  paymentStatus    PaymentStatus @default(PENDING)
  status           OrderStatus   @default(PLACED)
  estimatedReadyAt DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String // snapshot at order time
  unitPrice  Int // snapshot at order time, whole rupees
  quantity   Int
  lineTotal  Int // unitPrice * quantity
}
